[
  {
    "name": "core (effector-refetch)",
    "path": "dist/index.mjs",
    "limit": "10.5 kB",
    "ignore": ["effector"]
  },
  {
    "name": "react binding",
    "path": "dist/react.mjs",
    "limit": "1 kB",
    "ignore": ["effector", "effector-react", "react"]
  },
  {
    "name": "vue binding",
    "path": "dist/vue.mjs",
    "limit": "1 kB",
    "ignore": ["effector", "effector-vue", "effector-vue/composition", "vue"]
  },
  {
    "name": "solid binding",
    "path": "dist/solid.mjs",
    "limit": "1 kB",
    "ignore": ["effector", "effector-solid", "solid-js"]
  },
  {
    "name": "tanstack interop",
    "path": "dist/tanstack.mjs",
    "limit": "0.5 kB"
  },
  {
    "name": "apollo interop",
    "path": "dist/apollo.mjs",
    "limit": "0.5 kB"
  }
]

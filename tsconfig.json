{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "noEmit": true,
    // Generated example code imports the package by name (as user code would);
    // resolve it to the sources so typecheck doesn't require a built dist.
    "paths": {
      "effector-refetch": ["./src/index.ts"],
      "effector-refetch/openapi": ["./src/openapi.ts"]
    }
  },
  "include": ["src", "test", "examples"],
  // The Next.js example is a standalone app with its own tsconfig/deps (next types,
  // JSX transform) — typecheck it inside examples/nextjs, not from the root.
  "exclude": ["examples/nextjs"]
}
